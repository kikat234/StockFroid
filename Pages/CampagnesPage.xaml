<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockFroid.PageModels"
             xmlns:items="clr-namespace:StockFroid.PageModels.Items"
             x:Class="StockFroid.Pages.CampagnesPage"
             x:DataType="vm:CampagnesPageModel"
             Title="Campagnes"
             BackgroundColor="{StaticResource Fond}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Synthèse -->
            <Border Style="{StaticResource Carte}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource CarteStat}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="CAMPAGNES ACTIVES" Style="{StaticResource Libelle}" />
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding CampagnesActivesTexte}" Style="{StaticResource Valeur}" />
                                <Label Text="{Binding CampagnesTotalTexte}" Style="{StaticResource Muted}"
                                       VerticalOptions="End" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CarteStat}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="LOTS ACTIFS" Style="{StaticResource Libelle}" />
                            <Label Text="{Binding LotsActifsTexte}" Style="{StaticResource Valeur}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- Nouvelle campagne + recherche -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Button Text="+  Nouvelle campagne"
                        Command="{Binding NouvelleCampagneCommand}"
                        Style="{StaticResource BoutonPrincipal}"
                        Padding="16,0" />
                <Border Grid.Column="1" Style="{StaticResource Champ}">
                    <Entry Text="{Binding Recherche}" Placeholder="Rechercher"
                           Style="{StaticResource EntryChamp}" />
                </Border>
            </Grid>

            <!-- Filtres -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8"
                                       BindableLayout.ItemsSource="{Binding Filtres}"
                                       BindableLayout.ItemTemplate="{StaticResource FiltreTemplate}" />
            </ScrollView>

            <!-- États : chargement, erreur, vide -->
            <ActivityIndicator IsRunning="{Binding EstOccupe}" IsVisible="{Binding EstOccupe}"
                               Color="{StaticResource Primaire}" />

            <Border IsVisible="{Binding AErreur}"
                    BackgroundColor="{StaticResource DangerFond}"
                    StrokeThickness="0" Padding="14"
                    StrokeShape="RoundRectangle 12,12,12,12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Erreur}" Style="{StaticResource Erreur}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Réessayer"
                            Command="{Binding ReessayerCommand}"
                            Style="{StaticResource BoutonTexte}" />
                </Grid>
            </Border>

            <Label Text="Aucune campagne à afficher. Créez la première avec « Nouvelle campagne »."
                   IsVisible="{Binding EstVide}"
                   Style="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" />

            <!-- Cartes de campagne -->
            <VerticalStackLayout Spacing="12"
                                 BindableLayout.ItemsSource="{Binding Campagnes}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="items:CampagneItem">
                        <Border Style="{StaticResource Carte}" Opacity="{Binding Opacite}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CampagnesPageModel}}, Path=OuvrirCampagneCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Nom}" Style="{StaticResource TitreSection}"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource Pastille}"
                                            BackgroundColor="{Binding StatutFond}">
                                        <Label Text="{Binding StatutLibelle}" TextColor="{Binding StatutCouleur}"
                                               FontSize="13" FontAttributes="Bold" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Periode}" Style="{StaticResource Muted}" />

                                <Border IsVisible="{Binding AAlerte}"
                                        BackgroundColor="{StaticResource AttentionFond}"
                                        StrokeThickness="0" Padding="12,8"
                                        StrokeShape="RoundRectangle 10,10,10,10">
                                    <Label Text="{Binding AlerteTexte}" TextColor="{StaticResource Attention}"
                                           FontSize="13" />
                                </Border>

                                <BoxView HeightRequest="1" Color="{StaticResource Bordure}" />

                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding LibelleLots}" Style="{StaticResource Muted}" />
                                        <Label Text="{Binding ValeurLots}" FontAttributes="Bold" FontSize="16" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding LibelleTaux}" Style="{StaticResource Muted}" />
                                        <Label Text="{Binding ValeurTaux}" TextColor="{Binding CouleurTaux}"
                                               FontAttributes="Bold" FontSize="16" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="30"
                                           TextColor="{StaticResource TexteMuted}" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
