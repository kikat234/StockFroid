<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockFroid.PageModels"
             x:Class="StockFroid.Pages.ProfilPage"
             x:DataType="vm:ProfilPageModel"
             Title="Profil"
             BackgroundColor="{StaticResource Fond}">

    <VerticalStackLayout Padding="16" Spacing="16">
        <Border Style="{StaticResource Carte}">
            <VerticalStackLayout Spacing="4">
                <Label Text="AGENT CONNECTÉ" Style="{StaticResource Libelle}" />
                <Label Text="{Binding NomAgent}" Style="{StaticResource Titre}" />
            </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource Carte}">
            <Label Text="Les données sont enregistrées localement sur cet appareil : l'application fonctionne sans connexion."
                   Style="{StaticResource Muted}" />
        </Border>

        <Button Text="Se déconnecter"
                Command="{Binding SeDeconnecterCommand}"
                Style="{StaticResource BoutonSecondaire}" />
    </VerticalStackLayout>
</ContentPage>
